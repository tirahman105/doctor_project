# Phase 2A prepares SQL only. The app still requires explicit local demo mode.
NEXT_PUBLIC_DATA_MODE=local
# Future Phase 2B configuration: leave blank now. Never commit project URLs or keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix this secret with NEXT_PUBLIC or import it in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Future server adapter schema/bucket names are documented in SUPABASE_SETUP.md.
SUPABASE_DB_SCHEMA=
SUPABASE_PRIVATE_STORAGE_BUCKET=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
DOCTOR_MOBILE=
# Optional disposable LOCAL SQL test runner; never use a hosted connection string.
CAREBRIDGE_TEST_DATABASE_URL=
CAREBRIDGE_ALLOW_LOCAL_DB_TESTS=
CAREBRIDGE_PSQL_PATH=
CAREBRIDGE_POSTGRES_BIN=

# Phase 2B-1 hosted acceptance ONLY: all values stay blank in this template.
# Database URL, passwords and service-role key are secrets. Never add NEXT_PUBLIC.
CAREBRIDGE_TEST_PROJECT_REF=
CAREBRIDGE_PRODUCTION_PROJECT_REFS=
CAREBRIDGE_ACCEPTANCE_ENVIRONMENT=
CAREBRIDGE_ACCEPTANCE_URL=
CAREBRIDGE_ACCEPTANCE_ANON_KEY=
CAREBRIDGE_ACCEPTANCE_SERVICE_ROLE_KEY=
CAREBRIDGE_ACCEPTANCE_DATABASE_URL=
CAREBRIDGE_ACCEPTANCE_SSLROOTCERT=
CAREBRIDGE_ACCEPTANCE_PSQL_PATH=
CAREBRIDGE_ACCEPTANCE_DOCTOR_EMAIL=
CAREBRIDGE_ACCEPTANCE_DOCTOR_PASSWORD=
CAREBRIDGE_ACCEPTANCE_ASSISTANT_A_EMAIL=
CAREBRIDGE_ACCEPTANCE_ASSISTANT_A_PASSWORD=
CAREBRIDGE_ACCEPTANCE_ASSISTANT_B_EMAIL=
CAREBRIDGE_ACCEPTANCE_ASSISTANT_B_PASSWORD=
CAREBRIDGE_ACCEPTANCE_OUTSIDER_EMAIL=
CAREBRIDGE_ACCEPTANCE_OUTSIDER_PASSWORD=
