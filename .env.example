# Phase 2A prepares SQL only. The app still requires explicit local demo mode.
NEXT_PUBLIC_DATA_MODE=local
# Future Phase 2B configuration: leave blank now. Never commit project URLs or keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix this secret with NEXT_PUBLIC or import it in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Future server adapter schema/bucket names are documented in SUPABASE_SETUP.md.
SUPABASE_DB_SCHEMA=
SUPABASE_PRIVATE_STORAGE_BUCKET=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
DOCTOR_MOBILE=
# Optional disposable LOCAL SQL test runner; never use a hosted connection string.
CAREBRIDGE_TEST_DATABASE_URL=
CAREBRIDGE_ALLOW_LOCAL_DB_TESTS=
CAREBRIDGE_PSQL_PATH=
CAREBRIDGE_POSTGRES_BIN=
